APP_NAME=CleanPlates
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=replace-with-a-random-64-character-secret

DATABASE_URL=sqlite+aiosqlite:///./data/cleanplates.db
REDIS_URL=redis://redis:6379

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

CORS_ORIGINS=["https://cleanplates.example.com"]
ALLOWED_HOSTS=["cleanplates.example.com","localhost","127.0.0.1"]

UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
BACKUPS_DIR=./backups

AUDIT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
UVICORN_WORKERS=2
HTTP_PORT=80
